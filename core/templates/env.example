# Ссылки на репозитории: локальный абсолютный путь
# (или git-URL — тогда включите CONVEYOR_REPO_CACHE=true)
SYSTEMS_ANALYSIS_REPO=C:/work/systems-analysis
FRONTEND_REPO=C:/work/frontend
BACKEND_REPO=C:/work/backend
AUTOTEST_REPO=C:/work/autotests

# Основная ветка каждого репозитория (пусто = main по умолчанию)
SYSTEMS_ANALYSIS_MAIN_BRANCH=
FRONTEND_MAIN_BRANCH=
BACKEND_MAIN_BRANCH=
AUTOTEST_MAIN_BRANCH=

# Кэш репозиториев: разрешить клонировать git-URL в .cache/repos/
# (true — включить; пусто или false — выключен, значение по умолчанию)
CONVEYOR_REPO_CACHE=

# Число раундов цикла ревью (пусто = 2 по умолчанию; 0 — ревью выключено)
CONVEYOR_REVIEW_ROUNDS=
