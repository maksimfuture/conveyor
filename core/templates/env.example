# Личные настройки разработчика. Ссылки на репозитории и основные ветки
# живут в settings.json (он одинаковый у всей команды и коммитится).
# Этот файл в .gitignore и не обязателен: без него действуют умолчания.

# Число раундов цикла ревью (пусто = 2 по умолчанию; 0 — ревью выключено)
CONVEYOR_REVIEW_ROUNDS=

# Быстрый режим для медленных/слабых моделей (true — включить; пусто или
# false — выключен, значение по умолчанию). Включает: ревью отключено,
# валидация артефактов скриптом, короче git-контекст и диффы.
CONVEYOR_FAST=
